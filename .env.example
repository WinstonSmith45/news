# Скопируйте в .env и при необходимости измените.
# Обязательно: пароль PostgreSQL (без символов @ : / ? #, он подставляется в URL подключения)
POSTGRES_PASSWORD=change-me
POSTGRES_USER=news
POSTGRES_DB=news
# Период опроса источников по умолчанию, секунды
POLL_INTERVAL=3600
# Таймаут одного HTTP-запроса, секунды
HTTP_TIMEOUT=30
# Сколько раз подряд пытаться выполнить неудачный HTTP-запрос
HTTP_MAX_ATTEMPTS=5
# Пауза между попытками: base * 2^(n-1), но не больше max, секунды
HTTP_BACKOFF_BASE=1
HTTP_BACKOFF_MAX=30
# Пауза перед каждым запросом страницы статьи, секунды
REQUEST_DELAY=1
# Сколько циклов опроса пытаться получить полный текст, прежде чем пометить failed
CONTENT_MAX_CYCLES=3
LOG_LEVEL=INFO
